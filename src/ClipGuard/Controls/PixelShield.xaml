<!--
  The SandSlide pixel shield. Ported from the mock's inline SVG: an 8x9 grid
  with a 2x2 notch punched out at (3,2). Rendered with aliased edges so it
  stays crisp at every size, matching shape-rendering:crispEdges.
-->
<UserControl x:Class="ClipGuard.Controls.PixelShield"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <Viewbox Stretch="Uniform" RenderOptions.EdgeMode="Aliased">
    <Canvas Width="8" Height="9">
      <Rectangle Canvas.Left="1" Canvas.Top="0" Width="6" Height="1" Fill="{Binding Fill, ElementName=Root}" />
      <Rectangle Canvas.Left="0" Canvas.Top="1" Width="8" Height="4" Fill="{Binding Fill, ElementName=Root}" />
      <Rectangle Canvas.Left="1" Canvas.Top="5" Width="6" Height="2" Fill="{Binding Fill, ElementName=Root}" />
      <Rectangle Canvas.Left="2" Canvas.Top="7" Width="4" Height="1" Fill="{Binding Fill, ElementName=Root}" />
      <Rectangle Canvas.Left="3" Canvas.Top="8" Width="2" Height="1" Fill="{Binding Fill, ElementName=Root}" />
      <!-- the notch: punched in whatever colour sits behind the mark -->
      <Rectangle Canvas.Left="3" Canvas.Top="2" Width="2" Height="2" Fill="{Binding NotchFill, ElementName=Root}" />
    </Canvas>
  </Viewbox>
</UserControl>

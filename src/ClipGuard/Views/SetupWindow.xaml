<!--
  First-run setup wizard. 600px, four steps:
  welcome, terms, preferences, done.
-->
<Window x:Class="ClipGuard.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ctl="clr-namespace:ClipGuard.Controls"
        xmlns:views="clr-namespace:ClipGuard.Views"
        Title="ClipGuard Setup"
        Width="600" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        UseLayoutRounding="True"
        FontFamily="{StaticResource FontBody}"
        Foreground="{StaticResource Text}">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0"
                        CornerRadius="0" GlassFrameThickness="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <views:BoolToVisibilityConverter x:Key="BoolVis" />
  </Window.Resources>

  <StackPanel>

    <!-- ── Title bar ──────────────────────────────────────────────────── -->
    <Border Background="{StaticResource Neutral100}" Height="40"
            BorderBrush="{StaticResource Neutral300}" BorderThickness="0,0,0,1">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <ctl:ClipGuardMark Width="16" Height="16" VerticalAlignment="Center"
                             Fill="{StaticResource Accent}" Knockout="{StaticResource Neutral100}" />
          <TextBlock Text="ClipGuard Setup" Margin="8,0,0,0" VerticalAlignment="Center"
                     FontFamily="{StaticResource FontHeading}" FontWeight="SemiBold" FontSize="12" />
        </StackPanel>
        <Button Style="{StaticResource BtnChromeClose}" HorizontalAlignment="Right"
                Margin="0,0,6,0" Click="OnExitSetup"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <TextBlock Text="&#10005;" FontFamily="Segoe UI" FontSize="13" />
        </Button>
      </Grid>
    </Border>

    <!-- ── Progress: four equal bars, red once reached ────────────────── -->
    <Grid Margin="24,16,24,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border x:Name="Bar0" Grid.Column="0" Height="6" CornerRadius="3" Background="{StaticResource Accent}" />
      <Border x:Name="Bar1" Grid.Column="2" Height="6" CornerRadius="3" Background="{StaticResource Neutral300}" />
      <Border x:Name="Bar2" Grid.Column="4" Height="6" CornerRadius="3" Background="{StaticResource Neutral300}" />
      <Border x:Name="Bar3" Grid.Column="6" Height="6" CornerRadius="3" Background="{StaticResource Neutral300}" />
    </Grid>

    <!-- ── Step body ──────────────────────────────────────────────────── -->
    <Grid Margin="28,22,28,8" MinHeight="280">
      <StackPanel VerticalAlignment="Top">

        <TextBlock x:Name="StepLabel" FontWeight="SemiBold" FontSize="10"
                   ctl:Typography.Tracking="0.14"
                   Foreground="{StaticResource Accent700}" />

        <TextBlock x:Name="StepTitle" Margin="0,8,0,0" MaxWidth="460"
                   HorizontalAlignment="Left" TextWrapping="Wrap"
                   FontFamily="{StaticResource FontHeading}" FontWeight="Bold"
                   FontSize="22" LineHeight="25.3" />

        <TextBlock x:Name="StepBody" Margin="0,10,0,0" MaxWidth="480"
                   HorizontalAlignment="Left" TextWrapping="Wrap"
                   FontSize="13" LineHeight="20.15"
                   Foreground="{StaticResource Neutral700}" />

        <!-- Step 2: terms -->
        <StackPanel x:Name="TermsPanel" Margin="0,16,0,0" Visibility="Collapsed">
          <Border Style="{StaticResource Panel}" Height="150">
            <ScrollViewer Style="{StaticResource SlimScrollViewer}" Padding="16,14">
              <StackPanel>
                <TextBlock Text="ClipGuard End User License Agreement"
                           FontFamily="{StaticResource FontHeading}" FontWeight="Bold" FontSize="12" />
                <TextBlock Text="Last updated August 2026 · SandSlide Studio" Margin="0,8,0,0"
                           FontSize="11.5" Foreground="{StaticResource Neutral700}" />

                <TextBlock Margin="0,10,0,0" FontSize="11.5" LineHeight="18.4" TextWrapping="Wrap"
                           Foreground="{StaticResource Neutral700}">
                  <Run Text="1. The gist." FontWeight="Bold" />
                  <Run Text="ClipGuard monitors clipboard activity on this device to detect and block unwanted writes by other applications. It runs locally; your clipboard contents never leave your machine." />
                </TextBlock>

                <TextBlock Margin="0,8,0,0" FontSize="11.5" LineHeight="18.4" TextWrapping="Wrap"
                           Foreground="{StaticResource Neutral700}">
                  <Run Text="2. License." FontWeight="Bold" />
                  <Run Text="SandSlide Studio grants you a personal, non-exclusive, non-transferable license to use ClipGuard on devices you own or control. Don't resell it, reverse-engineer it, or pretend you made it." />
                </TextBlock>

                <TextBlock Margin="0,8,0,0" FontSize="11.5" LineHeight="18.4" TextWrapping="Wrap"
                           Foreground="{StaticResource Neutral700}">
                  <Run Text="3. Privacy." FontWeight="Bold" />
                  <Run Text="Clipboard history is stored locally and deleted per your retention setting. Optional crash reports contain no clipboard content, ever." />
                </TextBlock>

                <TextBlock Margin="0,8,0,0" FontSize="11.5" LineHeight="18.4" TextWrapping="Wrap"
                           Foreground="{StaticResource Neutral700}">
                  <Run Text="4. No warranty." FontWeight="Bold" />
                  <Run Text="ClipGuard is provided &#8220;as is.&#8221; We work hard, but no security software catches everything. Liability is limited to the amount you paid us (spoiler: probably zero)." />
                </TextBlock>

                <TextBlock Margin="0,8,0,0" FontSize="11.5" LineHeight="18.4" TextWrapping="Wrap"
                           Foreground="{StaticResource Neutral700}">
                  <Run Text="5. Updates." FontWeight="Bold" />
                  <Run Text="ClipGuard may auto-update to keep protection current. Major changes to these terms will be shown in-app before they apply." />
                </TextBlock>

                <TextBlock Margin="0,8,0,0" FontSize="11.5" LineHeight="18.4" TextWrapping="Wrap"
                           Foreground="{StaticResource Neutral700}">
                  <Run Text="6. Termination." FontWeight="Bold" />
                  <Run Text="Uninstalling ClipGuard ends this agreement. Your local data is removed with it." />
                </TextBlock>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <CheckBox x:Name="AcceptCheckBox" Style="{StaticResource AcceptCheck}"
                    Margin="0,14,0,0" Click="OnAcceptChanged">
            <TextBlock Text="I've read the terms (or at least scrolled past them) and I accept"
                       FontWeight="Medium" FontSize="13" />
          </CheckBox>
        </StackPanel>

        <!-- Step 3: preferences -->
        <StackPanel x:Name="PrefsPanel" Margin="0,14,0,0" Visibility="Collapsed">
          <Border Style="{StaticResource Panel}" Padding="14,11" Margin="0,0,0,6">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <TextBlock Text="Start ClipGuard with Windows" FontWeight="SemiBold" FontSize="13" />
                <TextBlock x:Name="StartupCaption"
                           Text="Recommended: protection from the moment you log in"
                           FontSize="11.5" Margin="0,2,0,0" Foreground="{StaticResource Neutral600}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <ToggleButton x:Name="PrefStartup" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                            VerticalAlignment="Center" IsChecked="True" />
            </Grid>
          </Border>

          <Border Style="{StaticResource Panel}" Padding="14,11" Margin="0,0,0,6">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <TextBlock Text="Launch minimized to tray" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text="No window on startup, just the shield in your tray"
                           FontSize="11.5" Margin="0,2,0,0" Foreground="{StaticResource Neutral600}" />
              </StackPanel>
              <ToggleButton x:Name="PrefMinimized" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                            VerticalAlignment="Center" IsChecked="True" />
            </Grid>
          </Border>

          <Border Style="{StaticResource Panel}" Padding="14,11" Margin="0,0,0,6">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <TextBlock Text="Show notifications" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text="Off means events go to the silent log only"
                           FontSize="11.5" Margin="0,2,0,0" Foreground="{StaticResource Neutral600}" />
              </StackPanel>
              <ToggleButton x:Name="PrefToasts" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                            VerticalAlignment="Center" IsChecked="True" />
            </Grid>
          </Border>

          <Border Style="{StaticResource Panel}" Padding="14,11">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <TextBlock Text="Send anonymous crash reports" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text="Helps SandSlide fix bugs. Never includes clipboard content"
                           FontSize="11.5" Margin="0,2,0,0" Foreground="{StaticResource Neutral600}" />
              </StackPanel>
              <ToggleButton x:Name="PrefCrash" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                            VerticalAlignment="Center" IsChecked="False" />
            </Grid>
          </Border>
        </StackPanel>

        <!-- Step 4: done -->
        <Border x:Name="DonePanel" Visibility="Collapsed" Margin="0,18,0,0"
                Background="{StaticResource Accent100}" CornerRadius="10"
                Padding="16,14" MaxWidth="480" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="12" Height="12" Fill="{StaticResource Accent}" VerticalAlignment="Center" />
            <TextBlock Text="Protection is on. ClipGuard is now living quietly in your system tray."
                       Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                       FontWeight="SemiBold" FontSize="13"
                       Foreground="{StaticResource Accent900}" />
          </StackPanel>
        </Border>

      </StackPanel>
    </Grid>

    <!-- ── Footer nav ─────────────────────────────────────────────────── -->
    <Border Background="{StaticResource Neutral100}"
            BorderBrush="{StaticResource Neutral300}" BorderThickness="0,1,0,0"
            Padding="24,16">
      <Grid>
        <Button x:Name="BackButton" Style="{StaticResource BtnGhost}"
                HorizontalAlignment="Left" Click="OnBack" />
        <Button x:Name="NextButton" Style="{StaticResource BtnPrimary}"
                HorizontalAlignment="Right" Click="OnNext" />
      </Grid>
    </Border>

  </StackPanel>
</Window>

<!-- Tray flyout — mock 5b. 300px, status header, stats, stacked actions. -->
<Window x:Class="ClipGuard.Views.TrayFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ClipGuard.Views"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="Height" Width="324"
        UseLayoutRounding="True"
        Deactivated="OnDeactivated"
        FontFamily="{StaticResource FontBody}"
        Foreground="{StaticResource Text}">

  <Window.Resources>
    <views:PausedToBrushConverter x:Key="PausedBrush" />
  </Window.Resources>

  <Border Margin="12" Background="{StaticResource Bg}" CornerRadius="14"
          BorderBrush="#1f000000" BorderThickness="1"
          Effect="{StaticResource ShadowPopup}">
    <StackPanel>

      <!-- status header -->
      <Border BorderBrush="{StaticResource Neutral300}" BorderThickness="0,0,0,1"
              Padding="16,14">
        <Grid>
          <StackPanel Orientation="Horizontal">
            <Border Width="8" Height="8" CornerRadius="3" VerticalAlignment="Center"
                    Background="{Binding Protection.IsPaused, Converter={StaticResource PausedBrush}}" />
            <TextBlock Text="{Binding Protection.StatusTitle}" Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource FontHeading}" FontWeight="Bold" FontSize="13" />
          </StackPanel>

          <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                  Style="{StaticResource BtnGhost}" FontSize="11" FontWeight="Medium"
                  Padding="4,2" Content="Open app" Click="OnOpenApp" />
        </Grid>
      </Border>

      <!-- stats -->
      <Border BorderBrush="{StaticResource Neutral300}" BorderThickness="0,0,0,1"
              Padding="16,12">
        <StackPanel>
          <Grid>
            <TextBlock Text="Events today" FontSize="12" Foreground="{StaticResource Neutral600}" />
            <TextBlock Text="{Binding Protection.EventsToday}" HorizontalAlignment="Right"
                       FontSize="12" FontWeight="SemiBold" />
          </Grid>
          <Grid Margin="0,10,0,0">
            <TextBlock Text="Blocked" FontSize="12" Foreground="{StaticResource Neutral600}" />
            <TextBlock Text="{Binding Protection.BlockedToday}" HorizontalAlignment="Right"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource Accent700}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- stacked actions, labels flush left -->
      <StackPanel Margin="16,12">
        <Button Content="{Binding Protection.PauseCta}" Style="{StaticResource BtnBlockSecondary}"
                Click="OnTogglePause" />
        <Button Content="Clear clipboard now" Style="{StaticResource BtnBlockGhost}"
                Margin="0,8,0,0" Click="OnClearClipboard" />
      </StackPanel>

    </StackPanel>
  </Border>
</Window>

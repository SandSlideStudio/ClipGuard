<!-- History tab: search + export, rows with content preview and a per-row rule action. -->
<UserControl x:Class="ClipGuard.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ClipGuard.Views"
             FontFamily="{StaticResource FontBody}"
             Foreground="{StaticResource Text}">

  <UserControl.Resources>
    <views:BoolToVisibilityConverter x:Key="BoolVis" />
    <views:BoolToVisibilityConverter x:Key="NotBoolVis" Invert="True" />
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ── Search + export ────────────────────────────────────────────── -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="14,9">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Viewbox Grid.Column="0" Width="13" Height="13" VerticalAlignment="Center">
            <Canvas Width="24" Height="24">
              <Path Data="{StaticResource IconSearch}" Stroke="{StaticResource Neutral600}"
                    StrokeThickness="2.5" />
            </Canvas>
          </Viewbox>

          <Grid Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="Search apps or content…" FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource Neutral600}"
                       Visibility="{Binding HasSearchText, Converter={StaticResource NotBoolVis}}" />
            <TextBox Style="{StaticResource SearchBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>
        </Grid>
      </Border>

      <Button Grid.Column="1" Content="Export" Style="{StaticResource BtnSecondary}"
              Margin="10,0,0,0" Click="OnExport" />
    </Grid>

    <!-- ── Event rows ─────────────────────────────────────────────────── -->
    <ScrollViewer Grid.Row="1" Margin="0,14,0,0" Style="{StaticResource SlimScrollViewer}">
      <ItemsControl ItemsSource="{Binding FilteredEvents}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource RowPanel}" Padding="14,12" Margin="0,0,0,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Viewbox Grid.Column="0" Width="15" Height="15" VerticalAlignment="Center"
                         Visibility="{Binding Blocked, Converter={StaticResource BoolVis}}">
                  <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource IconBan}" Stroke="{StaticResource Accent}"
                          StrokeThickness="2.5" />
                  </Canvas>
                </Viewbox>

                <Viewbox Grid.Column="0" Width="15" Height="15" VerticalAlignment="Center"
                         Visibility="{Binding Blocked, Converter={StaticResource NotBoolVis}}">
                  <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource IconClipboard}" Stroke="{StaticResource Neutral600}"
                          StrokeThickness="2.5" />
                  </Canvas>
                </Viewbox>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding ProcessName, Mode=OneWay}"
                         FontFamily="{StaticResource FontMono}" FontWeight="SemiBold" FontSize="12" />
                    <Run Text="{Binding ActionText, Mode=OneWay}" FontSize="11.5"
                         Foreground="{StaticResource Neutral600}" />
                  </TextBlock>
                  <TextBlock Margin="0,3,0,0" MaxWidth="420" HorizontalAlignment="Left"
                             FontFamily="{StaticResource FontMono}" FontSize="11.5"
                             Foreground="{StaticResource Neutral600}"
                             TextTrimming="CharacterEllipsis">
                    <Run Text="&#8220;" /><Run Text="{Binding ContentPreview, Mode=OneWay}" /><Run Text="&#8221;" />
                  </TextBlock>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding RelativeTime}" FontSize="11"
                           Margin="12,0" VerticalAlignment="Center"
                           Foreground="{StaticResource Neutral600}" />

                <Button Grid.Column="3" Content="{Binding Cta}" Style="{StaticResource BtnGhost}"
                        FontSize="11" Padding="10,6" Click="OnRowAction"
                        Tag="{Binding}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>

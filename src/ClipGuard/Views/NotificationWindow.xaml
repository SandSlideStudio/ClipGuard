<!--
  Notification ladder — mock 5c. One window, three layouts chosen by severity:
  small pill (allowed), medium card (blocked), large sticky card (high risk).
-->
<Window x:Class="ClipGuard.Views.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:ClipGuard.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" MaxWidth="404"
        UseLayoutRounding="True"
        FontFamily="{StaticResource FontBody}"
        Foreground="{StaticResource Text}">

  <!-- 12px gutter all round so the drop shadows have room to render.
       The window sizes to content: the one-line pill would otherwise stretch
       to the cards' 404px and read as an empty capsule, so the two card
       layouts pin themselves to 380 and only the pill flexes. -->
  <Grid Margin="12">

    <!-- ══ Small — allowed events, one line, auto-dismiss ═══════════════ -->
    <Border x:Name="SmallCard" Visibility="Collapsed"
            Background="{StaticResource Bg}" CornerRadius="99"
            BorderBrush="#1f000000" BorderThickness="1"
            HorizontalAlignment="Right" MaxWidth="380"
            Effect="{StaticResource ShadowPill}">
      <Grid Margin="15,9,7,9">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Neutral-700, not 500: the mark should read quiet for an allowed
             event, but at 15px on a light pill anything lighter disappears.
             The knockout takes the pill's own fill so the clip is a real hole. -->
        <ctl:ClipGuardMark Grid.Column="0" Width="17" Height="17" VerticalAlignment="Center"
                           Fill="{StaticResource Neutral700}" Knockout="{StaticResource Bg}" />

        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis">
          <Run x:Name="SmallProcess" FontFamily="{StaticResource FontMono}" FontSize="11" />
          <Run x:Name="SmallMessage" FontWeight="Medium" FontSize="12" />
        </TextBlock>

        <Button Grid.Column="2" Style="{StaticResource BtnChrome}" Width="26" Height="26"
                Click="OnDismiss">
          <TextBlock Text="&#10005;" FontFamily="Segoe UI" FontSize="11" />
        </Button>
      </Grid>
    </Border>

    <!-- ══ Medium — blocked write ═══════════════════════════════════════ -->
    <Border x:Name="MediumCard" Visibility="Collapsed" Width="380"
            Background="{StaticResource Bg}" CornerRadius="14"
            BorderBrush="#1f000000" BorderThickness="1"
            Effect="{StaticResource ShadowCard}">
      <!-- Clipped in code-behind: Border.CornerRadius doesn't clip children, so
           the progress bar would otherwise square off the bottom corners. -->
      <StackPanel x:Name="MediumContent" SizeChanged="OnMediumContentSizeChanged">
        <Grid Margin="18,16,18,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                  Background="{StaticResource Accent100}" VerticalAlignment="Top">
            <ctl:ClipGuardMark Width="20" Height="20"
                               Fill="{StaticResource Accent}"
                               Knockout="{StaticResource Accent100}" />
          </Border>

          <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
            <TextBlock Text="Caught one!" FontFamily="{StaticResource FontHeading}"
                       FontWeight="Bold" FontSize="13" />
            <TextBlock Margin="0,3,0,0" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                       Foreground="{StaticResource Neutral700}">
              <Run x:Name="MediumProcess" FontFamily="{StaticResource FontMono}" />
              <Run Text="tried to swap your clipboard. We blocked it and kept your copy safe." />
            </TextBlock>
          </StackPanel>

          <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource BtnGhost}"
                  Padding="4" VerticalAlignment="Top" Click="OnDismiss"
                  Foreground="{StaticResource Neutral600}">
            <TextBlock Text="&#10005;" FontFamily="Segoe UI" FontSize="12" />
          </Button>

          <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                      Orientation="Horizontal" Margin="12,12,0,0">
            <Button Content="Thanks!" Style="{StaticResource BtnPrimary}"
                    Padding="12,7" Click="OnDismiss" />
            <Button Content="Actually I need that" Style="{StaticResource BtnGhost}"
                    Padding="10,7" Margin="8,0,0,0" Click="OnRestore" />
          </StackPanel>
        </Grid>

        <!-- 4px auto-dismiss progress bar -->
        <Border Height="4" Background="{StaticResource Neutral200}" CornerRadius="0,0,14,14"
                ClipToBounds="True">
          <Border x:Name="ProgressFill" Background="{StaticResource Accent}"
                  HorizontalAlignment="Stretch" RenderTransformOrigin="0,0">
            <Border.RenderTransform>
              <ScaleTransform x:Name="ProgressScale" ScaleX="1" />
            </Border.RenderTransform>
          </Border>
        </Border>
      </StackPanel>
    </Border>

    <!-- ══ Large — high-risk swap, sticky ═══════════════════════════════ -->
    <Border x:Name="LargeCard" Visibility="Collapsed" Width="380"
            Background="{StaticResource Bg}" CornerRadius="14"
            BorderBrush="{StaticResource Accent}" BorderThickness="2"
            Effect="{StaticResource ShadowAlert}">
      <StackPanel>
        <!-- solid red header -->
        <Border Background="{StaticResource Accent}" CornerRadius="12,12,0,0" Padding="20,18,20,16">
          <StackPanel>
            <Grid>
              <TextBlock Text="Hold up. This one's serious." Foreground="White"
                         FontFamily="{StaticResource FontHeading}" FontWeight="Bold" FontSize="15" />
              <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnDismiss"
                      Foreground="White" Opacity="0.8" Cursor="Hand">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="4">
                      <ContentPresenter />
                    </Border>
                  </ControlTemplate>
                </Button.Template>
                <TextBlock Text="&#10005;" FontFamily="Segoe UI" FontSize="12" />
              </Button>
            </Grid>
            <TextBlock Margin="0,5,0,0" Foreground="White" Opacity="0.92"
                       FontSize="12" LineHeight="18" TextWrapping="Wrap">
              <Run x:Name="LargeProcess" FontFamily="{StaticResource FontMono}" />
              <Run x:Name="LargeBody" />
            </TextBlock>
          </StackPanel>
        </Border>

        <!-- copied-vs-written diff -->
        <StackPanel Margin="20,14,20,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="You copied" FontSize="11.5"
                       Foreground="{StaticResource Neutral600}" />
            <TextBlock x:Name="DiffOriginal" Grid.Row="0" Grid.Column="1" Margin="10,0,0,0"
                       FontFamily="{StaticResource FontMono}" FontSize="11.5"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="They wrote" Margin="0,6,0,0"
                       FontSize="11.5" FontWeight="SemiBold"
                       Foreground="{StaticResource Accent700}" />
            <TextBlock x:Name="DiffReplacement" Grid.Row="1" Grid.Column="1" Margin="10,6,0,0"
                       FontFamily="{StaticResource FontMono}" FontSize="11.5"
                       Foreground="{StaticResource Accent700}"
                       TextTrimming="CharacterEllipsis" />
          </Grid>

          <!-- "Keep my original" is already the state of the world — this just
               confirms it. The second button is the escape hatch for a false
               positive; without it a wrong call here is a dead end. -->
          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="Keep my original" Style="{StaticResource BtnPrimary}"
                    Padding="14,8" Click="OnDismiss" />
            <Button x:Name="LargeUseTheirs" Content="Use what they wrote"
                    Style="{StaticResource BtnSecondary}"
                    Padding="14,8" Margin="8,0,0,0" Click="OnRestore" />
          </StackPanel>

          <!-- Blocking a whole application is a big hammer, so it's a quiet
               third option — and hidden entirely for browsers, where it would
               stop every copy you make. -->
          <Button x:Name="LargeBlockApp" Style="{StaticResource BtnGhost}"
                  HorizontalAlignment="Left" Padding="0,6" Margin="0,6,0,0"
                  FontSize="11.5" Click="OnBlockApp" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ══ Warning — dangerous content, or a terminal about to receive it ═══
         Shares the high-risk card's language but shows the command itself
         rather than a before/after diff: nothing was replaced. Sticky.
    -->
    <Border x:Name="WarnCard" Visibility="Collapsed" Width="380"
            Background="{StaticResource Bg}" CornerRadius="14"
            BorderBrush="{StaticResource Accent}" BorderThickness="2"
            Effect="{StaticResource ShadowAlert}">
      <StackPanel>
        <Border Background="{StaticResource Accent}" CornerRadius="12,12,0,0" Padding="20,18,20,16">
          <StackPanel>
            <Grid>
              <TextBlock x:Name="WarnTitle" Foreground="White"
                         FontFamily="{StaticResource FontHeading}" FontWeight="Bold" FontSize="15"
                         TextWrapping="Wrap" Margin="0,0,24,0" />
              <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnDismiss"
                      Foreground="White" Opacity="0.8" Cursor="Hand">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="4">
                      <ContentPresenter />
                    </Border>
                  </ControlTemplate>
                </Button.Template>
                <TextBlock Text="&#10005;" FontFamily="Segoe UI" FontSize="12" />
              </Button>
            </Grid>
            <TextBlock x:Name="WarnBody" Margin="0,5,0,0" Foreground="White" Opacity="0.92"
                       FontSize="12" LineHeight="18" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <StackPanel Margin="20,14,20,16">
          <TextBlock x:Name="WarnContentLabel" Text="ON YOUR CLIPBOARD"
                     Style="{StaticResource CapsLabel}" />

          <Border Background="{StaticResource Accent100}"
                  BorderBrush="{StaticResource Accent300}" BorderThickness="1"
                  CornerRadius="8" Padding="12,10" Margin="0,6,0,0">
            <TextBlock x:Name="WarnContent" FontFamily="{StaticResource FontMono}"
                       FontSize="11.5" LineHeight="17"
                       Foreground="{StaticResource Accent800}"
                       TextWrapping="Wrap" MaxHeight="68" />
          </Border>

          <!-- When the command has been defused the clipboard is already safe,
               so the primary action is simply acknowledging it. -->
          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="WarnPrimary" Style="{StaticResource BtnPrimary}"
                    Padding="14,8" Click="OnWarnPrimary" />
            <Button x:Name="WarnSecondary" Style="{StaticResource BtnSecondary}"
                    Padding="14,8" Margin="8,0,0,0" Click="OnWarnSecondary" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>

  </Grid>
</Window>

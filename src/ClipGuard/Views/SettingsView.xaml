<!-- Settings tab — mock 3a: toggle rows in rounded panels + the auto-clear segmented control. -->
<UserControl x:Class="ClipGuard.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource FontBody}"
             Foreground="{StaticResource Text}">

  <UserControl.Resources>
    <!-- one toggle row: label + one-line description on the left, pill on the right -->
    <Style x:Key="ToggleRow" TargetType="Border" BasedOn="{StaticResource Panel}">
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer Style="{StaticResource SlimScrollViewer}">
    <StackPanel>

      <Border Style="{StaticResource ToggleRow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="Start ClipGuard with Windows" FontWeight="SemiBold" FontSize="13" />
            <TextBlock Text="Recommended — protection from the moment you log in"
                       FontSize="11.5" Margin="0,2,0,0" Foreground="{StaticResource Neutral600}" />
          </StackPanel>
          <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                        VerticalAlignment="Center"
                        IsChecked="{Binding Protection.Settings.StartWithWindows, Mode=TwoWay}"
                        Click="OnSettingChanged" />
        </Grid>
      </Border>

      <Border Style="{StaticResource ToggleRow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="Launch minimized to tray" FontWeight="SemiBold" FontSize="13" />
            <TextBlock Text="No window on startup, just the shield in your tray"
                       FontSize="11.5" Margin="0,2,0,0" Foreground="{StaticResource Neutral600}" />
          </StackPanel>
          <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                        VerticalAlignment="Center"
                        IsChecked="{Binding Protection.Settings.LaunchMinimized, Mode=TwoWay}"
                        Click="OnSettingChanged" />
        </Grid>
      </Border>

      <Border Style="{StaticResource ToggleRow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="Show notifications" FontWeight="SemiBold" FontSize="13" />
            <TextBlock Text="Off means events go to the silent log only"
                       FontSize="11.5" Margin="0,2,0,0" Foreground="{StaticResource Neutral600}" />
          </StackPanel>
          <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                        VerticalAlignment="Center"
                        IsChecked="{Binding Protection.Settings.ShowNotifications, Mode=TwoWay}"
                        Click="OnSettingChanged" />
        </Grid>
      </Border>

      <Border Style="{StaticResource ToggleRow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="Remember what was copied" FontWeight="SemiBold" FontSize="13" />
            <TextBlock Text="History keeps a short preview, encrypted on disk. Turn off to keep the verdicts but never the content."
                       FontSize="11.5" Margin="0,2,0,0" Foreground="{StaticResource Neutral600}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                        VerticalAlignment="Center"
                        IsChecked="{Binding Protection.Settings.RememberCopiedContent, Mode=TwoWay}"
                        Click="OnSettingChanged" />
        </Grid>
      </Border>

      <!-- ── ClickFix / fake-CAPTCHA defences ─────────────────────────── -->
      <Border Style="{StaticResource ToggleRow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="Warn about risky clipboard content" FontWeight="SemiBold" FontSize="13" />
            <TextBlock Text="Flags download-and-run commands the moment they land, even if nothing was swapped"
                       FontSize="11.5" Margin="0,2,0,0" Foreground="{StaticResource Neutral600}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                        VerticalAlignment="Center"
                        IsChecked="{Binding Protection.Settings.WarnRiskyContent, Mode=TwoWay}"
                        Click="OnSettingChanged" />
        </Grid>
      </Border>

      <Border Style="{StaticResource ToggleRow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="Defuse risky commands" FontWeight="SemiBold" FontSize="13" />
            <TextBlock Text="Swaps the command for a harmless one, so pasting it by accident does nothing. Always undoable from the warning."
                       FontSize="11.5" Margin="0,2,0,0" Foreground="{StaticResource Neutral600}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                        VerticalAlignment="Center"
                        IsChecked="{Binding Protection.Settings.DefuseRiskyCommands, Mode=TwoWay}"
                        Click="OnSettingChanged" />
        </Grid>
      </Border>

      <Border Style="{StaticResource ToggleRow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="Warn before pasting into a terminal" FontWeight="SemiBold" FontSize="13" />
            <TextBlock Text="Speaks up when a shell or the Run dialog opens with a command on your clipboard"
                       FontSize="11.5" Margin="0,2,0,0" Foreground="{StaticResource Neutral600}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                        VerticalAlignment="Center"
                        IsChecked="{Binding Protection.Settings.WarnBeforeTerminalPaste, Mode=TwoWay}"
                        Click="OnSettingChanged" />
        </Grid>
      </Border>

      <Border Style="{StaticResource ToggleRow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <!-- The mock said "Send anonymous crash reports". Nothing is sent
                 anywhere — that would be the one exception to "stays on this
                 machine" — so the label says what it actually does. -->
            <TextBlock Text="Save crash reports to disk" FontWeight="SemiBold" FontSize="13" />
            <TextBlock Text="Writes fault details to a local log folder — never includes clipboard content"
                       FontSize="11.5" Margin="0,2,0,0" Foreground="{StaticResource Neutral600}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                        VerticalAlignment="Center"
                        IsChecked="{Binding Protection.Settings.CrashReports, Mode=TwoWay}"
                        Click="OnSettingChanged" />
        </Grid>
      </Border>

      <!-- ── Auto-clear segmented control ─────────────────────────────── -->
      <Border Style="{StaticResource ToggleRow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="Auto-clear clipboard after" FontWeight="SemiBold" FontSize="13" />
            <TextBlock Text="Copied passwords shouldn't live forever"
                       FontSize="11.5" Margin="0,2,0,0" Foreground="{StaticResource Neutral600}" />
          </StackPanel>

          <Border Grid.Column="1" VerticalAlignment="Center"
                  Background="{StaticResource Bg}"
                  BorderBrush="{StaticResource Neutral300}" BorderThickness="1"
                  CornerRadius="9" ClipToBounds="True">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="ClearNever" Content="Never" GroupName="AutoClear"
                           Style="{StaticResource SegOption}" Checked="OnAutoClearChanged" />
              <RadioButton x:Name="Clear60" Content="60 s" GroupName="AutoClear"
                           Style="{StaticResource SegOption}" Checked="OnAutoClearChanged" />
              <RadioButton x:Name="Clear5Min" Content="5 min" GroupName="AutoClear"
                           Style="{StaticResource SegOption}" Checked="OnAutoClearChanged" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Border Style="{StaticResource ToggleRow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="Keep history for" FontWeight="SemiBold" FontSize="13" />
            <TextBlock Text="Older events are deleted automatically"
                       FontSize="11.5" Margin="0,2,0,0" Foreground="{StaticResource Neutral600}" />
          </StackPanel>

          <Border Grid.Column="1" VerticalAlignment="Center"
                  Background="{StaticResource Bg}"
                  BorderBrush="{StaticResource Neutral300}" BorderThickness="1"
                  CornerRadius="9" ClipToBounds="True">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="Keep24h" Content="24 hours" GroupName="Retention"
                           Style="{StaticResource SegOption}" Checked="OnRetentionChanged" />
              <RadioButton x:Name="Keep7d" Content="7 days" GroupName="Retention"
                           Style="{StaticResource SegOption}" Checked="OnRetentionChanged" />
              <RadioButton x:Name="Keep30d" Content="30 days" GroupName="Retention"
                           Style="{StaticResource SegOption}" Checked="OnRetentionChanged" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- How protection actually works — the footnote the desktop tier owes the user. -->
      <Border Style="{StaticResource Panel}" Padding="14,12" Margin="0,10,0,0">
        <StackPanel>
          <TextBlock Text="HOW BLOCKING WORKS" Style="{StaticResource CapsLabel}" />
          <TextBlock Margin="0,6,0,0" FontSize="11.5" TextWrapping="Wrap"
                     Foreground="{StaticResource Neutral700}"
                     Text="ClipGuard watches the Windows clipboard and identifies the app behind each change. When it spots a swap, it puts your original content back within milliseconds — before you can paste the replacement. It can't stop the write from landing in the first place; nothing outside the browser can. Your copy survives either way." />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>

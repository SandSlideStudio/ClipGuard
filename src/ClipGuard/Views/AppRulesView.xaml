<!--
  App rules tab. With process-level attribution the
  unit is an executable, so rows show `chrome.exe` rather than `site.tld`.
-->
<UserControl x:Class="ClipGuard.Views.AppRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ClipGuard.Views"
             FontFamily="{StaticResource FontBody}"
             Foreground="{StaticResource Text}">

  <UserControl.Resources>
    <views:RuleToBrushConverter x:Key="RuleBrush" />
    <views:BoolToVisibilityConverter x:Key="BoolVis" />
    <views:BoolToVisibilityConverter x:Key="NotBoolVis" Invert="True" />
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Button Grid.Row="0" Content="Add app" Style="{StaticResource BtnSecondary}"
            HorizontalAlignment="Right" Click="OnAddApp" />

    <!-- ── Download sources the user vouched for ──────────────────────────
         Learned when someone overrides a warning. Shown and removable by
         design: this list weakens protection, so it must never be invisible.
    -->
    <StackPanel Grid.Row="2" Margin="0,16,0,0"
                Visibility="{Binding HasTrustedSources, Converter={StaticResource BoolVis}}">
      <TextBlock Text="TRUSTED DOWNLOAD SOURCES" Style="{StaticResource SectionCaps}" />
      <TextBlock Text="You told ClipGuard these were fine, so commands that only fetch from them stay quiet."
                 FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"
                 Foreground="{StaticResource Neutral600}" />

      <ItemsControl ItemsSource="{Binding Protection.TrustedSources}" Margin="0,8,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource RowPanel}" Padding="14,10" Margin="0,0,0,6">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center"
                           FontFamily="{StaticResource FontMono}" FontSize="12"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="Remove" Style="{StaticResource BtnGhost}"
                        FontSize="11" Padding="10,6" Click="OnRemoveTrustedSource"
                        Tag="{Binding}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,12,0,0">
      <Border Style="{StaticResource Panel}" Padding="16,14" VerticalAlignment="Top"
              Visibility="{Binding HasRules, Converter={StaticResource NotBoolVis}}">
        <TextBlock Text="No rules yet. Block or always-allow an app from the History tab and it'll show up here."
                   FontSize="12" Foreground="{StaticResource Neutral600}" TextWrapping="Wrap" />
      </Border>

      <ScrollViewer Style="{StaticResource SlimScrollViewer}"
                    Visibility="{Binding HasRules, Converter={StaticResource BoolVis}}">
        <ItemsControl ItemsSource="{Binding Protection.Rules}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource RowPanel}" Padding="14,12" Margin="0,0,0,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <TextBlock Grid.Column="0" Text="{Binding ProcessName}" VerticalAlignment="Center"
                             FontFamily="{StaticResource FontMono}" FontSize="12" FontWeight="Medium"
                             TextTrimming="CharacterEllipsis" />

                  <!-- the tag doubles as the switch between block and allow -->
                  <Button Grid.Column="1" Margin="14,0,0,0" Cursor="Hand"
                          Click="OnToggleRule" Tag="{Binding}"
                          ToolTip="Click to switch this rule"
                          FocusVisualStyle="{StaticResource FocusVisual}">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="10,3"
                                Background="{Binding Rule, Converter={StaticResource RuleBrush}}">
                          <TextBlock Text="{Binding RuleText}" FontSize="11"
                                     Foreground="{Binding Rule, Converter={StaticResource RuleBrush}, ConverterParameter=ink}" />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>

                  <TextBlock Grid.Column="2" Text="{Binding LastEventText}" Margin="14,0"
                             VerticalAlignment="Center" FontSize="11"
                             Foreground="{StaticResource Neutral600}" />

                  <Button Grid.Column="3" Content="Remove" Style="{StaticResource BtnGhost}"
                          FontSize="11" Padding="10,6" Click="OnRemove" Tag="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>

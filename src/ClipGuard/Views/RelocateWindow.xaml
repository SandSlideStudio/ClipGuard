<!--
  Shown before anything else when ClipGuard is running from somewhere that
  won't last. Moving is the primary path; test mode is the way out for someone
  who just wants to try it.
-->
<Window x:Class="ClipGuard.Views.RelocateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ctl="clr-namespace:ClipGuard.Controls"
        Title="ClipGuard"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        UseLayoutRounding="True"
        FontFamily="{StaticResource FontBody}"
        Foreground="{StaticResource Text}">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0"
                        CornerRadius="0" GlassFrameThickness="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <StackPanel>

    <Border Background="{StaticResource Neutral100}" Height="40"
            BorderBrush="{StaticResource Neutral300}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
        <ctl:ClipGuardMark Width="16" Height="16" VerticalAlignment="Center"
                           Fill="{StaticResource Accent}" Knockout="{StaticResource Neutral100}" />
        <TextBlock Text="ClipGuard" Margin="8,0,0,0" VerticalAlignment="Center"
                   FontFamily="{StaticResource FontHeading}" FontWeight="SemiBold" FontSize="12" />
      </StackPanel>
    </Border>

    <StackPanel Margin="28,24,28,8">

      <TextBlock x:Name="Headline" TextWrapping="Wrap"
                 FontFamily="{StaticResource FontHeading}" FontWeight="Bold"
                 FontSize="22" LineHeight="25.3" />

      <TextBlock x:Name="Explanation" Margin="0,10,0,0" TextWrapping="Wrap"
                 FontSize="13" LineHeight="20.15"
                 Foreground="{StaticResource Neutral700}" />

      <TextBlock Text="MOVE IT TO" Style="{StaticResource CapsLabel}" Margin="0,20,0,0" />

      <Border Style="{StaticResource Panel}" Padding="14,11" Margin="0,6,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock x:Name="Destination" Grid.Column="0" VerticalAlignment="Center"
                     FontFamily="{StaticResource FontMono}" FontSize="11.5"
                     TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />

          <Button Grid.Column="1" Content="Change" Style="{StaticResource BtnGhost}"
                  FontSize="11.5" Padding="10,5" Click="OnChooseFolder" />
        </Grid>
      </Border>

      <TextBlock x:Name="Failure" Visibility="Collapsed" Margin="0,10,0,0"
                 TextWrapping="Wrap" FontSize="12"
                 Foreground="{StaticResource Accent700}" />

    </StackPanel>

    <Border Background="{StaticResource Neutral100}"
            BorderBrush="{StaticResource Neutral300}" BorderThickness="0,1,0,0"
            Padding="28,16" Margin="0,16,0,0">
      <Grid>
        <Button Content="Continue in test mode" Style="{StaticResource BtnGhost}"
                HorizontalAlignment="Left" Click="OnTestMode" />
        <Button x:Name="MoveButton" Content="Move and restart"
                Style="{StaticResource BtnPrimary}"
                HorizontalAlignment="Right" Click="OnMove" />
      </Grid>
    </Border>

  </StackPanel>
</Window>

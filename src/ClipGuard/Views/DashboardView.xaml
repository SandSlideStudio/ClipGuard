<!-- Dashboard tab — mock 3a/5a: stat cards, actions, latest events. -->
<UserControl x:Class="ClipGuard.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ClipGuard.Views"
             FontFamily="{StaticResource FontBody}"
             Foreground="{StaticResource Text}">

  <UserControl.Resources>
    <views:BoolToVisibilityConverter x:Key="BoolVis" />
    <views:BoolToVisibilityConverter x:Key="NotBoolVis" Invert="True" />
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ── Stat cards ─────────────────────────────────────────────────── -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource StatCard}">
        <StackPanel>
          <TextBlock Text="EVENTS TODAY" Style="{StaticResource CapsLabel}" />
          <TextBlock Text="{Binding Protection.EventsToday}" Style="{StaticResource StatNumber}" />
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource StatCardAccent}">
        <StackPanel>
          <TextBlock Text="BLOCKED" Style="{StaticResource CapsLabel}"
                     Foreground="{StaticResource Accent700}" />
          <TextBlock Text="{Binding Protection.BlockedToday}" Style="{StaticResource StatNumber}"
                     Foreground="{StaticResource Accent700}" />
        </StackPanel>
      </Border>

      <Border Grid.Column="4" Style="{StaticResource StatCard}">
        <StackPanel>
          <TextBlock Text="APPS BLOCKED" Style="{StaticResource CapsLabel}" />
          <TextBlock Text="{Binding Protection.AppsBlocked}" Style="{StaticResource StatNumber}" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- ── Actions ────────────────────────────────────────────────────── -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
      <Button Content="Clear clipboard" Style="{StaticResource BtnPrimary}"
              Click="OnClearClipboard" />
      <Button Content="{Binding Protection.PauseCta}" Style="{StaticResource BtnSecondary}"
              Margin="10,0,0,0" Click="OnTogglePause" />
    </StackPanel>

    <TextBlock Grid.Row="2" Text="LATEST EVENTS" Style="{StaticResource SectionCaps}"
               Margin="0,22,0,10" />

    <!-- ── Latest events ──────────────────────────────────────────────── -->
    <ScrollViewer Grid.Row="3" Style="{StaticResource SlimScrollViewer}">
      <Grid>
        <!-- empty state: no events yet -->
        <Border Style="{StaticResource Panel}" Padding="16,14"
                Visibility="{Binding HasEvents, Converter={StaticResource NotBoolVis}}">
          <TextBlock Text="Nothing yet. ClipGuard is watching — copy something and go about your day."
                     FontSize="12" Foreground="{StaticResource Neutral600}" TextWrapping="Wrap" />
        </Border>

        <ItemsControl ItemsSource="{Binding LatestEvents}"
                      Visibility="{Binding HasEvents, Converter={StaticResource BoolVis}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource RowPanel}" Padding="14,11" Margin="0,0,0,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <!-- blocked: slashed circle in accent -->
                  <Viewbox Grid.Column="0" Width="15" Height="15"
                           Visibility="{Binding Blocked, Converter={StaticResource BoolVis}}">
                    <Canvas Width="24" Height="24">
                      <Path Data="{StaticResource IconBan}" Stroke="{StaticResource Accent}"
                            StrokeThickness="2.5" />
                    </Canvas>
                  </Viewbox>

                  <!-- allowed: clipboard outline in neutral -->
                  <Viewbox Grid.Column="0" Width="15" Height="15"
                           Visibility="{Binding Blocked, Converter={StaticResource NotBoolVis}}">
                    <Canvas Width="24" Height="24">
                      <Path Data="{StaticResource IconClipboard}" Stroke="{StaticResource Neutral600}"
                            StrokeThickness="2.5" />
                    </Canvas>
                  </Viewbox>

                  <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding ProcessName, Mode=OneWay}"
                         FontFamily="{StaticResource FontMono}" FontWeight="SemiBold" FontSize="12" />
                    <Run Text="{Binding ActionText, Mode=OneWay}" FontSize="11.5"
                         Foreground="{StaticResource Neutral600}" />
                  </TextBlock>

                  <TextBlock Grid.Column="2" Text="{Binding RelativeTime}" FontSize="11"
                             VerticalAlignment="Center" Foreground="{StaticResource Neutral600}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>

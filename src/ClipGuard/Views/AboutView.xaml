<!-- About tab. -->
<UserControl x:Class="ClipGuard.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ClipGuard.Controls"
             xmlns:views="clr-namespace:ClipGuard.Views"
             FontFamily="{StaticResource FontBody}"
             Foreground="{StaticResource Text}">

  <UserControl.Resources>
    <views:BoolToVisibilityConverter x:Key="BoolVis" />
  </UserControl.Resources>

  <Border Style="{StaticResource Panel}" CornerRadius="12" Padding="20,18"
          MaxWidth="460" HorizontalAlignment="Left" VerticalAlignment="Top">
    <StackPanel>
      <StackPanel Orientation="Horizontal">
        <!-- Animates while checking for updates: the mark's own motion, rather
             than a generic spinner bolted on beside it. -->
        <ctl:ClipGuardMark x:Name="Mark" Width="36" Height="36" VerticalAlignment="Center"
                           IsAnimating="{Binding Updates.IsChecking}"
                           Fill="{StaticResource Accent}"
                           Knockout="{StaticResource Neutral100}"
                           ThreatFill="{StaticResource Neutral400}" />
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <!-- Bound, not written out: a hardcoded version here would go stale
               the first time one of us forgot to edit it. -->
          <TextBlock Text="{Binding Updates.CurrentVersionText, StringFormat='ClipGuard v{0}'}"
                     FontFamily="{StaticResource FontHeading}"
                     FontWeight="Bold" FontSize="15" />
          <TextBlock Text="by SandSlide Studio · yes, the game people"
                     FontSize="11.5" Foreground="{StaticResource Neutral600}" />
        </StackPanel>
      </StackPanel>

      <TextBlock Margin="0,12,0,0" FontSize="12" LineHeight="18.6" TextWrapping="Wrap"
                 Foreground="{StaticResource Neutral700}"
                 Text="We got tired of apps messing with our clipboards between playtests, so we built this. Everything runs locally, so your clipboard never leaves your machine." />

      <StackPanel Orientation="Horizontal" Margin="0,14,0,0" VerticalAlignment="Center">
        <Button x:Name="UpdateButton" Content="Check for updates"
                Style="{StaticResource BtnSecondary}"
                FontSize="11.5" Click="OnCheckUpdates" />
        <Button Content="Get the update" Style="{StaticResource BtnPrimary}"
                FontSize="11.5" Margin="8,0,0,0" Click="OnOpenReleases"
                Visibility="{Binding Updates.HasUpdate, Converter={StaticResource BoolVis}}" />
        <Button Content="sandslide.studio" Style="{StaticResource BtnGhost}"
                FontSize="11.5" Margin="8,0,0,0" Click="OnOpenSite" />
      </StackPanel>

      <TextBlock Text="{Binding Updates.StatusText}" Margin="0,10,0,0"
                 FontSize="11.5" TextWrapping="Wrap"
                 Foreground="{StaticResource Neutral600}" />

      <!-- Say what the check does, where the check is. A tool that promises
           your clipboard never leaves the machine owes the user a plain account
           of its one outbound request. -->
      <TextBlock Margin="0,8,0,0" FontSize="11" LineHeight="17" TextWrapping="Wrap"
                 Foreground="{StaticResource Neutral600}"
                 Text="Checking asks GitHub for the list of releases and nothing else. No identifier is sent, nothing is downloaded automatically, and you can turn the daily check off in Settings." />
    </StackPanel>
  </Border>
</UserControl>

<!--
  Consumer main window — mock 5a, with tab content from 3a.
  880x560, custom 40px title bar, 200px sidebar.
-->
<Window x:Class="ClipGuard.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ctl="clr-namespace:ClipGuard.Controls"
        xmlns:views="clr-namespace:ClipGuard.Views"
        Title="ClipGuard"
        Width="880" Height="560" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        FontFamily="{StaticResource FontBody}"
        Foreground="{StaticResource Text}">

  <!-- WindowChrome keeps native snap/maximize/resize while letting us draw
       the whole title bar. Windows 11 supplies the rounded corner + shadow. -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40"
                        ResizeBorderThickness="6"
                        CornerRadius="0"
                        GlassFrameThickness="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <views:IndexToVisibilityConverter x:Key="IndexVis" />
    <views:PausedToBrushConverter x:Key="PausedBrush" />
    <views:HealthToBrushConverter x:Key="HealthBrush" />
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ══ Title bar ══════════════════════════════════════════════════════ -->
    <Border Grid.Row="0" Background="{StaticResource Neutral100}"
            BorderBrush="{StaticResource Neutral300}" BorderThickness="0,0,0,1">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <ctl:ClipGuardMark Width="16" Height="16" VerticalAlignment="Center"
                             Fill="{StaticResource Accent}"
                             Knockout="{StaticResource Neutral100}" />
          <TextBlock Text="ClipGuard" Margin="8,0,0,0" VerticalAlignment="Center"
                     FontFamily="{StaticResource FontHeading}" FontWeight="SemiBold" FontSize="12" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource BtnChrome}" Click="OnMinimize" ToolTip="Minimise">
            <TextBlock Text="&#8213;" FontFamily="Segoe UI" FontSize="13" />
          </Button>
          <Button Style="{StaticResource BtnChrome}" Click="OnMaximize" ToolTip="Maximise">
            <TextBlock Text="&#9633;" FontFamily="Segoe UI" FontSize="10" />
          </Button>
          <Button Style="{StaticResource BtnChromeClose}" Click="OnClose" ToolTip="Close to tray">
            <TextBlock Text="&#10005;" FontFamily="Segoe UI" FontSize="12" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ══ Body ═══════════════════════════════════════════════════════════ -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- ── Sidebar ───────────────────────────────────────────────────── -->
      <Border Grid.Column="0" Background="{StaticResource Neutral100}"
              BorderBrush="{StaticResource Neutral300}" BorderThickness="0,0,1,0">
        <DockPanel Margin="10,14">

          <!-- status chip, pinned bottom -->
          <Border DockPanel.Dock="Bottom" Background="{StaticResource Bg}"
                  BorderBrush="{StaticResource Neutral300}" BorderThickness="1"
                  CornerRadius="10" Padding="12,10">
            <StackPanel Orientation="Horizontal">
              <!-- Hollow ring when unhealthy: "not protecting" must not look
                   like the normal on state at a glance. -->
              <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                       StrokeThickness="2"
                       Stroke="{Binding Protection.IsHealthy, Converter={StaticResource HealthBrush}}"
                       Fill="{Binding Protection.IsPaused, Converter={StaticResource PausedBrush}}">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Protection.IsHealthy}" Value="False">
                        <Setter Property="Fill" Value="Transparent" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <StackPanel Margin="10,0,0,0">
                <TextBlock Text="{Binding Protection.StatusTitle}"
                           FontWeight="SemiBold" FontSize="11.5" />
                <TextBlock Text="v1.4.2 · SandSlide" FontSize="10.5"
                           Foreground="{StaticResource Neutral600}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <ListBox x:Name="Nav" DockPanel.Dock="Top"
                   ItemsSource="{Binding Tabs}"
                   SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                   Background="Transparent" BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Bd" CornerRadius="9" Padding="12,9"
                              Margin="0,0,0,4" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                          <Border x:Name="Dot" Width="8" Height="8" CornerRadius="3"
                                  VerticalAlignment="Center"
                                  Background="{StaticResource Neutral400}" />
                          <TextBlock x:Name="Tx" Text="{Binding Label}" Margin="10,0,0,0"
                                     FontWeight="SemiBold" FontSize="12.5"
                                     Foreground="{StaticResource Neutral700}" />
                        </StackPanel>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="{StaticResource Neutral200}" />
                        </Trigger>
                        <!-- selected must win over hover -->
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="{StaticResource Text}" />
                          <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource Bg}" />
                          <Setter TargetName="Dot" Property="Background" Value="{StaticResource Accent}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- ── Content ───────────────────────────────────────────────────── -->
      <Grid Grid.Column="1" Margin="26,22">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
          <TextBlock Text="{Binding TabTitle}" Style="{StaticResource PageTitle}" />
          <TextBlock Text="{Binding TabSubtitle}" Style="{StaticResource PageSub}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
          <views:DashboardView
              Visibility="{Binding SelectedTabIndex, Converter={StaticResource IndexVis}, ConverterParameter=0}" />
          <views:HistoryView
              Visibility="{Binding SelectedTabIndex, Converter={StaticResource IndexVis}, ConverterParameter=1}" />
          <views:AppRulesView
              Visibility="{Binding SelectedTabIndex, Converter={StaticResource IndexVis}, ConverterParameter=2}" />
          <views:SettingsView
              Visibility="{Binding SelectedTabIndex, Converter={StaticResource IndexVis}, ConverterParameter=3}" />
          <views:AboutView
              Visibility="{Binding SelectedTabIndex, Converter={StaticResource IndexVis}, ConverterParameter=4}" />
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
